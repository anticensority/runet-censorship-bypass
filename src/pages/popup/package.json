{
  "name": "my-node-app",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.mjs"
  },
  "scripts": {
    "init": "rm -rf ./_generated; mkdir -p ./_generated;",
    "start": "npm run init; node ./src/index.html.mjs > ./_generated/index.html; cp ./src/*.copy.mjs ./_generated/."
  }
}
